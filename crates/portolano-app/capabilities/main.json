{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: events, its own window, links in the browser and the commands of the app (SPEC-UI §4.8). No dialog permission: native dialogs are opened by Rust (SPEC-UI §4.6), the others are components of the interface.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "allow-app-status",
    "allow-choose-document",
    "allow-choose-new-document",
    "allow-open-document",
    "allow-create-document",
    "allow-recent-documents",
    "allow-reload-document",
    "allow-close-document",
    "allow-tree",
    "allow-node-details",
    "allow-search",
    "allow-add-node",
    "allow-edit-node",
    "allow-move-node",
    "allow-duplicate-node",
    "allow-preview-delete",
    "allow-delete-node",
    "allow-undo-delete",
    "allow-secret-status",
    "allow-set-secret",
    "allow-clear-secret",
    "allow-vault-status",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-create-file-vault",
    "allow-validate",
    "allow-choose-import-file",
    "allow-import-preview",
    "allow-import-apply",
    "allow-save-import-report",
    "allow-connect-preview",
    "allow-login-request",
    "allow-config-get",
    "allow-config-set",
    "allow-config-reset",
    "allow-choose-config-file",
    "allow-ui-prefs-get",
    "allow-ui-prefs-set",
    "allow-builtin-icons",
    "allow-custom-icons",
    "allow-choose-icon-file",
    "allow-add-icon"
  ]
}
