# Documenti Royal di esempio: contengono dati reali, mai nel repo
samples/
*.rtsz
*.rtsx
# Fixture sintetiche dei test (dati finti, SPEC §8.3.6): sempre nel repo
!crates/**/tests/fixtures/**

# Vault / dati locali dell'app
*.vault
.portolano/

# Build
target/
node_modules/
dist/
.DS_Store

# App desktop (FASE 2)
frontend/node_modules/
frontend/dist/
frontend/dist-e2e/
# Sidecar copiato da `npm run bundle` e schemi generati da tauri-build
crates/portolano-app/binaries/
crates/portolano-app/gen/
# Output di Playwright
frontend/test-results/
frontend/e2e-screenshots/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
