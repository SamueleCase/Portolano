{
  "name": "portolano-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf:glass": "PERF_GLASS=1 playwright test",
    "bindings": "cargo run --quiet -p portolano-app --example export_bindings -- src/bindings.ts",
    "bindings:check": "cargo test --quiet -p portolano-app --lib bindings::",
    "tauri": "TAURI_APP_PATH=../crates/portolano-app TAURI_FRONTEND_PATH=. tauri",
    "bundle": "sh scripts/bundle.sh"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "~5.3.0",
    "@fontsource/ibm-plex-mono": "~5.3.0",
    "@headless-tree/core": "~1.8.0",
    "@headless-tree/react": "~1.8.0",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-opener": "~2.7.3",
    "@xterm/addon-fit": "~0.11.0",
    "@xterm/addon-web-links": "~0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^1.72.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.65.0",
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.10",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "~31.0.0",
    "prettier": "~3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "vite": "~8.3.8",
    "vitest": "~5.1.0"
  }
}
